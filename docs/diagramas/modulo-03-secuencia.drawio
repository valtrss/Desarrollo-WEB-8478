e="0" parent="e23"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="e25" style="html=1;verticalAlign=bottom;rounded=0;fontSize=10;fontColor=#2E3138;strokeColor=#2E3138;endFill=1;endArrow=block;exitX=0.5;exitY=0.7031;exitDx=0;exitDy=0;entryX=0.5;entryY=0.7031;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c8"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="lb26" value="inicia transacción" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontColor=#2E3138;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e25"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="e27" style="html=1;verticalAlign=bottom;rounded=0;fontSize=10;fontColor=#C0392B;strokeColor=#C0392B;endFill=1;endArrow=block;exitX=0.5;exitY=0.7812;exitDx=0;exitDy=0;entryX=0.5;entryY=0.7812;entryDx=0;entryDy=0;" edge="1" parent="1" source="c8" target="c7"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="lb28" value="webhook firmado + idempotencia" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontColor=#2E3138;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e27"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="e29" style="html=1;verticalAlign=bottom;rounded=0;fontSize=10;fontColor=#C0392B;strokeColor=#C0392B;endFill=1;endArrow=block;exitX=0.5;exitY=0.8594;exitDx=0;exitDy=0;entryX=0.5;entryY=0.8594;entryDx=0;entryDy=0;" edge="1" parent="1" source="c7" target="c5"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="lb30" value="pedido pagado" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontColor=#2E3138;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e29"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="e31" style="html=1;verticalAlign=bottom;rounded=0;fontSize=10;fontColor=#C0392B;strokeColor=#C0392B;endFill=1;endArrow=block;exitX=0.5;exitY=0.9297;exitDx=0;exitDy=0;entryX=0.5;entryY=0.9297;entryDx=0;entryDy=0;" edge="1" parent="1" source="c5" target="c6"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="lb32" value="ConsumirReserva" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontColor=#2E3138;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e31"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="c33" value="&lt;b&gt;Lo que este diagrama demuestra&lt;/b&gt;&lt;br&gt;1. El pedido nace en &lt;i&gt;pendiente_pago&lt;/i&gt; y reserva stock antes de aceptarse: no se puede vender producción que ya no existe.&lt;br&gt;2. El salto de &lt;i&gt;pendiente_pago&lt;/i&gt; a &lt;i&gt;pagado&lt;/i&gt; lo dispara el proveedor contra payments, con firma e idempotencia. El navegador nunca interviene en ese tramo.&lt;br&gt;3. Recién con el pago confirmado la reserva se consume y la producción sale del stock del día." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#C3C7CE;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#2E3138;" vertex="1" parent="1"><mxGeometry x="60" y="780" width="1140" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>