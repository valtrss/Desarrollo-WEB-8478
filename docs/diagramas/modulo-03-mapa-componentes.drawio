to explícito." style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#C3C7CE;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#2E3138;" vertex="1" parent="1"><mxGeometry x="40" y="800" width="1210" height="90" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>