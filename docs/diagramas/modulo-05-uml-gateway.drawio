.75" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="e67" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;endArrow=none;strokeColor=#2E3138;strokeWidth=1.5;" edge="1" parent="1" source="cl41" target="cl44"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="lb68" value="1" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontColor=#2E3138;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e67"><mxGeometry x="-0.75" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="lb69" value="1..*" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontColor=#2E3138;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e67"><mxGeometry x="0.75" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="e70" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;dashed=1;endArrow=open;endSize=10;strokeColor=#8A9099;strokeWidth=1.5;" edge="1" parent="1" source="cl21" target="cl49"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="lb71" value="emite" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontColor=#2E3138;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e70"><mxGeometry relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="e72" style="edgeStyle=orthogonalEdgeStyle;rounded=0;html=1;jettySize=auto;orthogonalLoop=1;dashed=1;dashPattern=6 4;endArrow=open;endSize=10;strokeColor=#C0392B;strokeWidth=1.5;" edge="1" parent="1" source="cl49" target="cl18"><mxGeometry relative="1" as="geometry"/></mxCell><mxCell id="lb73" value="viaja al servicio" style="edgeLabel;html=1;align=center;verticalAlign=middle;resizable=0;points=[];fontSize=10;fontColor=#2E3138;labelBackgroundColor=#FFFFFF;" vertex="1" connectable="0" parent="e72"><mxGeometry x="0.75" relative="1" as="geometry"><mxPoint as="offset"/></mxGeometry></mxCell><mxCell id="c74" value="&lt;b&gt;Qué valida cada capa&lt;/b&gt;&lt;br&gt;&lt;b style='color:#C0392B'&gt;API Gateway:&lt;/b&gt; que la ruta exista en la tabla, que el token sea válido y no esté revocado, que el rol pueda usar el verbo, y el límite por IP.&lt;br&gt;&lt;b style='color:#C0392B'&gt;Servicio interno:&lt;/b&gt; que la identidad venga firmada por el gateway y sea para él (aud), y luego TODA la regla de negocio: propiedad del recurso, estado, stock.&lt;br&gt;&lt;b style='color:#C0392B'&gt;GraphQL Gateway:&lt;/b&gt; profundidad y costo de la consulta, y autorización por campo. POST /graphql no autoriza por sí mismo cada operación.&lt;br&gt;&lt;br&gt;&lt;b&gt;El gateway filtra; no sustituye. Un servicio interno nunca confía en que alguien ya revisó por él.&lt;/b&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3F4F6;strokeColor=#C0392B;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;fontSize=11;fontColor=#2E3138;" vertex="1" parent="1"><mxGeometry x="70" y="960" width="1110" height="120" as="geometry"/></mxCell></root></mxGraphModel></diagram></mxfile>